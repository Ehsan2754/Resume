# One source, one PDF per persona.
#   make                 → all personas into dist/
#   make C-englead       → dist/Shaghaei_Ehsan_Resume_EngLead.pdf
#   make C-englead APP=/path/to/application-dir COMPANY=Amazon ROLE=SDM-Nitro
#                        → application overlay on top of the persona, dated file name
#   make check PDF=…     → honesty/ATS gate only
PERSONAS   := A-edgeml B-platformfw C-englead D-fae E-lowlatency
DATE       := $(shell date +%Y-%m-%d)
ENGINE     ?= -xelatex
LATEXMK    := latexmk $(ENGINE) -interaction=nonstopmode -halt-on-error

short_A-edgeml      := EdgeML
short_B-platformfw  := PlatformFW
short_C-englead     := EngLead
short_D-fae         := FAE
short_E-lowlatency  := LowLatencyCpp

.PHONY: all clean check $(PERSONAS)
all: $(PERSONAS)

$(PERSONAS):
	@rm -rf build/$@ && mkdir -p build/$@/Content dist
	@cp -r Setting Images resume.tex build/$@/
	@cp Content/*.tex build/$@/Content/
	@for f in personas/$@/Content/*.tex; do [ -e "$$f" ] && cp "$$f" build/$@/Content/ || true; done
	@if [ -n "$(APP)" ] && [ -d "$(APP)/Content" ]; then for f in "$(APP)"/Content/*.tex; do [ -e "$$f" ] && cp "$$f" build/$@/Content/ || true; done; fi
	@HEADLINE=""; if [ -n "$(APP)" ] && [ -f "$(APP)/headline.txt" ]; then HEADLINE="$$(cat "$(APP)/headline.txt")"; fi; \
	 [ -n "$$HEADLINE" ] || HEADLINE="$$(cat personas/$@/headline.txt)"; \
	 PHOTO="$$(cat personas/$@/photo.txt 2>/dev/null || echo Images/profile.png)"; \
	 if [ -n "$(APP)" ] && [ -f "$(APP)/photo.txt" ]; then PHOTO="$$(cat "$(APP)/photo.txt")"; fi; \
	 [ "$$PHOTO" = none ] && PHOTO=""; \
	 printf '%%%% generated by Makefile — do not edit\n\\newcommand*{\\ResumeHeadline}{%s}\n\\newcommand*{\\ResumePhoto}{%s}\n' \
	   "$$HEADLINE" "$$PHOTO" > build/$@/headline.tex
	@ORDER=personas/$@/order.txt; if [ -n "$(APP)" ] && [ -f "$(APP)/order.txt" ]; then ORDER="$(APP)/order.txt"; fi; \
	 sed -e 's/[[:space:]]*$$//' -e '/^$$/d' -e 's|^\(.*\)$$|\\input{Content/\1.tex}|' "$$ORDER" > build/$@/includes.tex
	@cd build/$@ && $(LATEXMK) resume.tex >/dev/null 2>&1 || { tail -40 resume.log || true; exit 1; }
	@OUT="dist/Shaghaei_Ehsan_Resume_$(short_$@).pdf"; \
	 if [ -n "$(COMPANY)" ]; then OUT="dist/Shaghaei_Ehsan_Resume_$(COMPANY)_$(ROLE)_$(DATE).pdf"; fi; \
	 cp build/$@/resume.pdf "$$OUT" && echo "built $$OUT" && $(MAKE) --no-print-directory check PDF="$$OUT"

# Honesty + ATS gate: real text layer, no banned words, no unreconciled numbers, no hidden text.
# tools/banned-allowlist.txt: verbatim strings (published paper titles) exempt from the banned-word scan; one fixed string per line, no comments.
# tools/unreconciled.txt also matches U+FFFD: the ⚠️ marker has no glyph in the PDF font, so it shows up as that replacement char in the text layer.
check:
	@test -n "$(PDF)" || { echo "usage: make check PDF=file.pdf"; exit 2; }
	@mkdir -p build && pdftotext -layout "$(PDF)" build/check.txt
	@test "$$(wc -w < build/check.txt)" -gt 150 || { echo "FAIL: PDF has no usable text layer"; exit 1; }
	@HITS="$$(grep -i -n -E -f tools/banned-words.txt build/check.txt | grep -v -i -F -f tools/banned-allowlist.txt || true)"; \
	 if [ -n "$$HITS" ]; then echo "$$HITS"; echo "FAIL: banned words (Style Guide §2)"; exit 1; fi
	@if grep -n -E -f tools/unreconciled.txt build/check.txt; then echo "WARN: unreconciled numbers / ⚠️ placeholders present (Open Reconciliations) — not for sending"; fi
	@python3 tools/hidden_text_check.py "$(PDF)"
	@echo "pages: $$(pdfinfo "$(PDF)" | awk '/^Pages/{print $$2}')  OK: $(PDF)"

clean:
	rm -rf build dist
